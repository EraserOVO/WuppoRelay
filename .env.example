# ============================================================
# WuppoRelay 运行配置模板
#
# 安装：双击 install.bat 后，若不存在 .env.prod 会自动复制本文件。
# 使用：用记事本打开 .env.prod，把每个值替换成你自己的配置。
# 注意：.env.prod 包含密钥，不要提交到 git，也不要外传。
#
# 每项详细说明见 docs/SETUP.md
# ============================================================

# 日志级别：DEBUG / INFO / WARNING / ERROR（DEBUG 日志量很大，排查时再用）
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Discord Bot
# 在 https://discord.com/developers/applications 创建应用，
# 在 Bot 页面获取 Token，并开启 Message Content Intent（特权网关意图）。
# 这里必须填你自己的 Bot Token，否则无法连接 Discord。
# ------------------------------------------------------------
DISCORD_BOTS='[{"token": "在这里粘贴你的DiscordBotToken"}]'

# ------------------------------------------------------------
# QQ 官方机器人
# 在 https://q.qq.com 创建机器人，获取 AppID 与 AppSecret。
# 注意：id 与 token 都填 AppID（官方 Bot 以 AppID 作为 token），
# secret 填 AppSecret。
# ------------------------------------------------------------
QQ_BOTS='[{"id": "你的AppID", "token": "你的AppID", "secret": "你的AppSecret"}]'

# ------------------------------------------------------------
# HTTP 代理（国内访问 Discord 必需）
# 填你本地代理软件监听的地址，例如 Clash 默认 http://127.0.0.1:7890。
# 不需要代理时留空即可。
# ------------------------------------------------------------
HTTP_PROXY=

# ------------------------------------------------------------
# 媒体下载参数（一般不需要改）
# API_TIMEOUT：单个媒体下载超时秒数
# MEDIA_CONCURRENCY：同时下载的媒体数量
# MEDIA_MAX_BYTES：单文件大小上限（字节），超过则放弃下载、降级为链接
# ------------------------------------------------------------
API_TIMEOUT=120
MEDIA_CONCURRENCY=4
MEDIA_MAX_BYTES=31457280
